# swanctl configuration for {{vpnservice.id}}
# Generated by neutron-vpnaas

connections {
{% for ipsec_site_connection in vpnservice.ipsec_site_connections %}
  {{ipsec_site_connection.id}} {
    local_addrs  = [ {{ipsec_site_connection.external_ip}} ]
    remote_addrs = [ {{ipsec_site_connection.peer_address}} ]

    peers {
      local {
        auth = psk
        id   = {{ipsec_site_connection.local_id}}
      }
      remote {
        auth = psk
        id   = {{ipsec_site_connection.peer_id}}
      }
    }

    ikesa {
      version           = {{ipsec_site_connection.ikepolicy.ike_version}}
      keylife            = {{ipsec_site_connection.ikepolicy.lifetime_value}}s
      rekey_time         = 3m
      rekey_margin       = 3m
      keyingtries        = 1
      mobike             = no
      dpd_delay          = {{ipsec_site_connection.dpd_interval}}s
      dpd_timeout        = {{ipsec_site_connection.dpd_timeout}}s
      dpd_action         = {{ipsec_site_connection.dpd_action}}

      proposals {
        encryption = {{ipsec_site_connection.ikepolicy.encryption_algorithm}}
        integrity  = {{ipsec_site_connection.ikepolicy.auth_algorithm}}
        pfs        = {{ipsec_site_connection.ikepolicy.pfs}}
      }
    }

    children {
      {{ipsec_site_connection.id}}_child {
        start_action = trap
        req_mode     = tunnel
        ipcomp         = no

        local_ts  = [ {% for cidr in ipsec_site_connection['local_cidrs'] %}{{cidr}}{% if not loop.last %}, {% endif %}{% endfor %} ]
        remote_ts = [ {% for cidr in ipsec_site_connection['peer_cidrs'] %}{{cidr}}{% if not loop.last %}, {% endif %}{% endfor %} ]

        proposals {
          encryption = {{ipsec_site_connection.ipsecpolicy.encryption_algorithm}}
{% if ipsec_site_connection.ipsecpolicy.transform_protocol != "ah" and 'cm' not in ipsec_site_connection.ipsecpolicy.encryption_algorithm %}
          integrity  = {{ipsec_site_connection.ipsecpolicy.auth_algorithm}}
{% endif %}
          pfs        = {{ipsec_site_connection.ipsecpolicy.pfs}}
{% if ipsec_site_connection.ipsecpolicy.transform_protocol == "ah" %}
          protocol   = ah
{% else %}
          protocol   = esp
{% endif %}
        }

        lifetime {
          seconds = {{ipsec_site_connection.ipsecpolicy.lifetime_value}}s
        }
      }
    }
  }
{% endfor %}
}

# swanctl.conf generated by neutron-vpnaas for {{vpnservice.id}}

connections {
{% for ipsec_site_connection in vpnservice.ipsec_site_connections %}
  {{ipsec_site_connection.id}} {
    version = {{ipsec_site_connection.ikepolicy.ike_version}}
    local_addrs = {{ipsec_site_connection.external_ip}}
    remote_addrs = {{ipsec_site_connection.peer_address}}
    keyingtries = 1
    mobike = no
{%- if ipsec_site_connection.ikepolicy.phase1_negotiation_mode == "aggressive" %}
    aggressive = yes
{%- endif %}
    dpd_delay = {{ipsec_site_connection.dpd_interval}}s
    dpd_timeout = {{ipsec_site_connection.dpd_timeout}}s
    rekey_time = {{ipsec_site_connection.ikepolicy.lifetime_value}}s
    proposals = {{ipsec_site_connection.ikepolicy.encryption_algorithm}}-{{ipsec_site_connection.ikepolicy.auth_algorithm}}-{{ipsec_site_connection.ikepolicy.pfs}}

    local {
      auth = psk
      id = {{ipsec_site_connection.local_id}}
    }
    remote {
      auth = psk
      id = {{ipsec_site_connection.peer_id}}
    }

    children {
      {{ipsec_site_connection.id}} {
        mode = {{ipsec_site_connection.ipsecpolicy.encapsulation_mode}}
        start_action = {{ipsec_site_connection.initiator}}
        dpd_action = {{ipsec_site_connection.dpd_action}}
        local_ts = {{ipsec_site_connection['local_cidrs']|join(', ')}}
        remote_ts = {{ipsec_site_connection['peer_cidrs']|join(', ')}}
        rekey_time = {{ipsec_site_connection.ipsecpolicy.lifetime_value}}s
{%- if ipsec_site_connection.ipsecpolicy.transform_protocol == "ah" %}
        ah_proposals = {{ipsec_site_connection.ipsecpolicy.auth_algorithm}}-{{ipsec_site_connection.ipsecpolicy.pfs}}
{%- elif 'cm' in ipsec_site_connection.ipsecpolicy.encryption_algorithm %}
        esp_proposals = {{ipsec_site_connection.ipsecpolicy.encryption_algorithm}}-{{ipsec_site_connection.ipsecpolicy.pfs}}
{%- else %}
        esp_proposals = {{ipsec_site_connection.ipsecpolicy.encryption_algorithm}}-{{ipsec_site_connection.ipsecpolicy.auth_algorithm}}-{{ipsec_site_connection.ipsecpolicy.pfs}}
{%- endif %}
      }
    }
  }
{% endfor %}
}

include secrets.conf
